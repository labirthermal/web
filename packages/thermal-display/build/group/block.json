{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "thermal-display/group",
  "version": "0.1.0",
  "title": "Group of IR images",
  "category": "thermal",
  "icon": "file:./assets/icon.svg",
  "description": "Upload multiple IR images and analyse them in the browser.",
  "example": {},
  "supports": {
    "interactivity": false,
    "html": false,
    "anchor": true,
    "lock": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "padding": true,
      "margin": true
    }
  },
  "textdomain": "thermal-display",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js",
  "keywords": [
    "webcomponent",
    "IR Camera",
    "embed",
    "LRC"
  ],
  "attributes": {
    "layout": {
      "type": "object",
      "default": {
        "type": "constrained"
      }
    },
    "files": {
      "type": "string"
    },
    "palette": {
      "type": "string",
      "default": "iron"
    },
    "unit": {
      "type": "string",
      "default": "C"
    },
    "opacity": {
      "type": "number",
      "default": 1
    },
    "from": {
      "type": "number"
    },
    "to": {
      "type": "number"
    },
    "tool": {
      "type": "string",
      "default": "inspect"
    },
    "autohighlight": {
      "type": "boolean",
      "default": false
    },
    "label": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "default": "CC BY-SA 4.0"
    },
    "showfullscreen": {
      "type": "boolean",
      "default": false
    },
    "smooththermograms": {
      "type": "boolean",
      "default": false
    },
    "smoothgraph": {
      "type": "boolean",
      "default": false
    },
    "analysis1": {
      "type": "string"
    },
    "analysis2": {
      "type": "string"
    },
    "analysis3": {
      "type": "string"
    },
    "analysis4": {
      "type": "string"
    },
    "analysis5": {
      "type": "string"
    },
    "analysis6": {
      "type": "string"
    },
    "analysis7": {
      "type": "string"
    },
    "skin": {
      "type": "string",
      "default": "default"
    },
    "lines": {
      "type": "string",
      "default": "default"
    },
    "corners": {
      "type": "string",
      "default": "default"
    }
  }
}