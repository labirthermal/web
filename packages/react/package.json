{
  "name": "@labirthermal/react",
  "version": "2.0.2",
  "author": "Jan Jáchim <jachim@ntc.zcu.cz>",
  "description": "React wrapper around @labirthermal/webcomponents.",
  "main": "./dist/lib/index.export.cjs",
  "module": "./dist/lib/index.export.mjs",
  "types": "./dist/lib/index.export.d.mts",
  "type": "module",
  "files": [
    "dist/lib",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/labirthermal/web",
    "directory": "packages/react"
  },
  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/index.export.d.mts",
        "default": "./dist/lib/index.export.mjs"
      },
      "require": {
        "types": "./dist/lib/index.export.d.cts",
        "default": "./dist/lib/index.export.cjs"
      }
    }
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@labirthermal/core": "workspace:*",
    "@labirthermal/webcomponents": "workspace:*",
    "@lit/context": "^1.1.6",
    "@lit/react": "^1.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "0.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^3.2.4"
  }
}
